# Feature caches and weights: large and easy to rebuild
features/
runs/
*.pth
*.pt
*.npz
*.npy

# Run logs
outputs/logs/

# Split index files (65,000 integers) are rebuilt the same way
# by data.get_split, so they do not need to be versioned.
outputs/split_*.json

# Experiment results are small and are part of the work, so we keep them.
!outputs/
!outputs/*.csv
!outputs/*.json
!outputs/figures/
!outputs/figures/*.png

# The dataset must never be committed
ms-coco/

# Environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Misc
.DS_Store
